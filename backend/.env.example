# Copy this file to .env and replace the placeholder locally.
# Get the Session pooler connection string from Supabase Dashboard > Connect.
# Ensure sslmode=require is present. Do not use the direct connection string
# on an IPv4-only home network because it often requires IPv6.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_URL_ENCODED_PASSWORD@YOUR_SESSION_POOLER_HOST:5432/postgres?sslmode=require
# Keep false for deployed serverless instances. Run `python database.py` locally to apply the schema.
RUN_DB_INIT_ON_STARTUP=false